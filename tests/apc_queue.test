<?php

/**
 * @file
 * Contains ApcQueueTestCase.
 */

declare(strict_types=1);

use apc_storage\queue\Queue;

require_once __DIR__ . '/apc_test_base.class.inc';

/**
 * Tests for the queue implementation.
 *
 * @testClass
 */
class ApcQueueTestCase extends ApcTestBase {

  /**
   * The queues used from tests.
   *
   * @var array
   */
  protected array $queues = array();

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      foreach ($this->queues as $data) {
        $data->instance->deleteQueue();
      }
    }
    parent::tearDown();
  }

  /**
   * Initializes the queues used to test the APCu queue implementation.
   *
   * @return bool
   *   TRUE if the queues are successfully initialized, FALSE otherwise.
   */
  protected function initQueues(): bool {
    foreach ($this->queues as $name => $data) {
      $data->instance = new Queue($name);
      $data->items = array();

      for ($i = 0; $i < 4; $i++) {
        $data->items[$this->randomName()] = $this->randomString();
      }

      $count = 0;
      foreach ($data->items as $id => $item) {
        $message = format_string(
          'Item @name has been added to the @queue queue.',
          array('@name' => $id, '@queue' => $name)
        );
        $this->assertTrue($data->instance->createItem($item['value']), $message);
        $count++;
      }

      $message = format_string(
        'All items have been added to the @queue queue.',
        array('@queue' => $name)
      );

      if (!$this->assertTrue($count == count($data->items), $message)) {
        return FALSE;
      }
    }

    return TRUE;
  }

  /**
   * Tests that queue items are correctly added.
   */
  public function testAddItem(): void {
    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $message = format_string(
          'numberOfItems() returned the correct number of items for the @queue queue.',
          array('@queue' => $name)
        );
        $this->assertEqual(
          $data->instance->numberOfItems(),
          count($data->items),
          $message
        );
      }
    }
  }

  /**
   * Tests that items can be claimed from the queue.
   *
   * This test uses a random lease time lower than the default one.
   */
  public function testClaimItem(): void {
    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $lease_time = 5;
        $claimed = 0;

        for ($i = 0; $i < $count; $i++) {
          $obj = $data->instance->claimItem($lease_time);
          $message = format_string(
            'An item was claimed from the @queue queue.',
            array('@queue' => $name)
          );

          if ($this->assertTrue($obj instanceof stdClass, $message)) {
            $claimed++;
          }
        }

        $message = format_string(
          'All items have been claimed from the @queue queue.',
          array('@queue' => $name)
        );

        $this->assertTrue($claimed == $count, $message);
        $obj = $data->instance->claimItem();
        $message = format_string(
          'It was not possible to claim further items from the @queue queue.',
          array('@queue' => $name)
        );

        $this->assertNull($obj, $message);
      }
    }
  }

  /**
   * Tests that items can be immediately claimed after they are released.
   */
  public function testReleaseItem(): void {
    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $data->claimedItems = 0;
        $data->claimedObjects = array();

        for ($i = 0; $i < $count; $i++) {
          $obj = $data->instance->claimItem();
          $message = format_string(
            'An item was claimed from the @queue queue.',
            array('@queue' => $name)
          );

          if ($this->assertNotNull($obj, $message)) {
            $data->claimedItems++;
            $data->claimedObjects[] = $obj;
          }
        }

        $this->assertTrue($data->claimedItems == $count,
          format_string('All items have been claimed from the @queue queue.',
            array('@queue' => $name)
          )
        );

        $obj = $data->instance->claimItem();
        $this->assertNull($obj,
          format_string('It was not possible to claim further items from the @queue queue.',
            array('@queue' => $name)
          )
        );
      }

      foreach ($this->queues as $name => $data) {
        foreach ($data->claimedObjects as $obj) {
          $data->instance->releaseItem($obj);
        }

        $count = count($data->items);

        for ($i = 0; $i < $count; $i++) {
          $obj = $data->instance->claimItem();
          $this->assertNotNull($obj,
            format_string('An item was claimed from the @queue queue for the second time.',
              array('@queue' => $name)
            )
          );
        }

        $this->assertTrue($data->claimedItems == $count,
          format_string('All items have been claimed from the @queue queue for the second time.',
            array('@queue' => $name)
          )
        );

        $obj = $data->instance->claimItem();
        $this->assertNull($obj,
          format_string('It was not possible to claim further items from the @queue queue for the second time.',
            array('@queue' => $name)
          )
        );
      }
    }
  }

  /**
   * Tests that items cannot be claimed after the queue is deleted.
   */
  public function testDeleteQueue(): void {
    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $data->instance->deleteQueue();
        $claimed_items = 0;

        for ($i = 0; $i < count($data->items); $i++) {
          $obj = $data->instance->claimItem();
          if (!is_null($obj)) {
            $claimed_items++;
          }
        }

        $message = format_string(
          'No items were claimed from the @queue queue after it was deleted.',
          array('@queue' => $name)
        );

        $this->assertTrue($claimed_items == 0, $message);
      }
    }
  }

}
