<?php

/**
 * @file
 * Hook implementations for the APC Storage Queue Test Support module.
 */

/**
 * Implements hook_cron_queue_info().
 */
function apc_storage_queue_test_support_cron_queue_info(): array {
  $queues['apc_storage_test_first_queue'] = array(
    'worker callback' => 'apc_storage_queue_test_callback',
    'time' => 60,
  );
  $queues['apc_storage_test_second_queue'] = array(
    'worker callback' => 'apc_storage_queue_test_callback',
    'time' => 60,
  );

  return $queues;
}

/**
 * Callback worker for the test queue.
 */
function apc_storage_queue_test_callback() {
  // This function is intentionally left empty.
}
