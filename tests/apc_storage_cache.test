<?php

/**
 * @file
 * Test classes for the cache implementation done by the APC Storage module.
 */

declare(strict_types=1);

require_once __DIR__ . '/apc_storage_base_test.class.inc';

/**
 * Base class for the cache test classes.
 */
class ApcStorageCacheBaseTestCase extends ApcStorageBaseTestCase {

  /**
   * The cache bins to store on APCu.
   *
   * @var array
   */
  protected array $cacheBins = array('apc_storage_test');

  /**
   * {@inheritdoc}
   */
  protected function setUp(): void {
    global $settings;

    $settings['cache_backends'][] = backdrop_get_path('module', 'apc_storage') . '/includes/apc_storage_cache.class.inc';

    foreach ($this->getCacheBins() as $cache_bin) {
      $settings["cache_class_$cache_bin"] = 'ApcStorageCache';
    }

    // The BackdropFakeCache class is a cache backend stub implementation used
    // by Backdrop core during installation. It is used as default backend class
    // so that only the cache bins used from tests are stored.
    $settings['cache_backends'][] = 'core/includes/cache-install.inc';
    $settings['cache_default_class'] = 'BackdropFakeCache';

    require_once BACKDROP_ROOT . '/core/includes/cache.inc';

    foreach ($settings['cache_backends'] as $include) {
      require_once BACKDROP_ROOT . '/' . $include;
    }

    parent::setUp();
  }

  /**
   * Adds cache bins to the list of cache bins that are stored on APCu.
   *
   * @param string ...$bins
   *   The cache bins to add.
   */
  protected function setCacheBins(string ...$bins): void {
    $this->cacheBins = array_unique(array_merge($this->cacheBins, $bins));
  }

  /**
   * Retrieves the cache bins that are stored on APCu.
   *
   * @return array
   *   The cache bins stored on APCu.
   */
  protected function getCacheBins(): array {
    return $this->cacheBins;
  }

  /**
   * Asserts that all the cache bins used by tests are stored on APCu.
   *
   * @return bool
   *   FALSE if any cache bin is not stored on APCu, TRUE otherwise.
   */
  protected function assertCacheBinsOnApcu(): bool {
    $result = TRUE;

    foreach ($this->getCacheBins() as $bin) {
      $cache = cache($bin);
      $args = array('@bin' => $this->varExport($bin));
      $message = format_string('Data for the @bin cache bin is stored on APCu.', $args);

      if (!$this->assertTrue($cache instanceof ApcStorageCache, $message)) {
        $result = FALSE;
      }
    }

    return $result;
  }

  /**
   * Asserts that a cache item is saved.
   *
   * @param string $bin
   *   The cache bin.
   * @param string $cid
   *   The cache ID.
   * @param mixed $value
   *   The value of the cache item.
   * @param int $ttl
   *   The time to live in seconds.
   *
   * @return bool
   *   TRUE if the cache item is saved, FALSE otherwise.
   */
  protected function assertCacheItemSaved(string $bin, string $cid, mixed $value, int $ttl = 0): bool {
    cache_set($cid, $value, $bin, $ttl > 0 ? $ttl + time() : CACHE_PERMANENT);

    return $this->assertCacheItem($bin, $cid, array('value' => $value));
  }

  /**
   * Asserts that a cache item exists.
   *
   * @param string $bin
   *   The cache bin.
   * @param string $cid
   *   The cache ID.
   * @param array $options
   *   An array of extra, optional, values, such as:
   *     - 'message': A message to display with the assertion. If none is given,
   *       a default message will be displayed. This string will be passed to
   *       format_string(). It can use @id as placeholder.
   *     - 'value': The expected value of the cache item. Any value passed in
   *       this key will be used, including FALSE, an empty string, or 0.
   *
   * @return bool
   *   TRUE if the cache item exists, FALSE otherwise.
   */
  protected function assertCacheItem(string $bin, string $cid, array $options = array()): bool {
    $args = array('@id' => $this->varExport("$bin/$cid"));
    $item = cache_get($cid, $bin);

    if (!empty($options['message'])) {
      $string = $options['message'];
    }
    else {
      $string = 'The value of @id was retrieved from the cache.';
    }

    $message = format_string($string, $args);

    if ($this->assertNotIdentical($item, FALSE, $message)) {
      $args = array('@id' => $this->varExport("$bin/$cid"));
      $message = format_string('@id was correctly stored in the cache.', $args);

      if ($this->assertTrue(is_object($item) && isset($item->data), $message)) {
        if (array_key_exists('value', $options)) {
          $value = $options['value'];
          $args = array('@id' => $this->varExport("$bin/$cid"));
          $message = format_string('The value of @id is the expected one.', $args);

          return $this->assertIdentical($item->data, $value, $message);
        }
      }
    }

    return FALSE;
  }

  /**
   * Asserts that a cache item does not exist.
   *
   * @param string $bin
   *   The cache bin.
   * @param string $cid
   *   The cache ID.
   * @param array $options
   *   An array of extra, optional, values, such as:
   *     - 'message': A message to display with the assertion. If none is given,
   *       a default message will be displayed. This string will be passed to
   *       format_string(). It can use @id as placeholder.
   *
   * @return bool
   *   TRUE if the cache item does not exist, FALSE otherwise.
   */
  protected function assertNoCacheItem(string $bin, string $cid, array $options = array()): bool {
    $args = array('@id' => $this->varExport("$bin/$cid"));

    if (array_key_exists('message', $options) && !empty($options['message'])) {
      $string = $options['message'];
    }
    else {
      $string = 'The value of @id was retrieved from the cache.';
    }

    $item = cache_get($cid, $bin);
    $message = format_string($string, $args);

    return $this->assertIdentical($item, FALSE, $message);
  }

  /**
   * Asserts that two or more cache items do exist.
   *
   * This method calls cache_get_multiple() to retrieve the items.
   *
   * @param string $bin
   *   The cache bin.
   * @param string ...$cids
   *   An array containing the cache IDs to retrieve.
   *
   * @return bool
   *   TRUE if the assertion succeeded, FALSE otherwise.
   */
  protected function assertCacheItems(string $bin, string ...$cids): bool {
    // cache_get_multiple() gets $cids by reference. To avoid it alters this
    // method's $cids parameter, pass it a copy.
    $cache_ids = $cids;
    $items = cache_get_multiple($cache_ids, $bin);
    $result = TRUE;

    foreach ($cids as $cid) {
      $args = array('@id' => $this->varExport("$bin/$cid"));
      $message = format_string('@id was found in the cache.', $args);

      if (!$this->assertTrue(isset($items[$cid]), $message)) {
        $result = FALSE;
      }
    }

    return $result;
  }

  /**
   * Asserts that two or more cache items do not exist.
   *
   * This method calls cache_get_multiple() to retrieve the items.
   *
   * @param string $bin
   *   The cache bin.
   * @param array $cids
   *   An array containing the cache IDs to retrieve.
   * @param string ...$non_existent_cids
   *   An array containing the cache IDs that should not exist.
   *
   * @return bool
   *   TRUE if the assertion succeeded, FALSE otherwise.
   */
  protected function assertNoCacheItems(string $bin, array $cids, string ...$non_existent_cids): bool {
    // cache_get_multiple() gets $cids by reference. To avoid it alters this
    // method's $cids parameter, pass it a copy.
    $cache_ids = $cids;
    $items = cache_get_multiple($cache_ids, $bin);
    $result = TRUE;

    foreach ($non_existent_cids as $cid) {
      $args = array('@id' => $this->varExport("$bin/$cid"));
      $message = format_string('@id was not found in the cache.', $args);

      if (!$this->assertFalse(isset($items[$cid]), $message)) {
        $result = FALSE;
      }
    }

    return $result;
  }

}

/**
 * Unit tests for storing and retrieving cache items.
 */
class ApcStorageCacheStoreAndRetrieveTestCase extends ApcStorageCacheBaseTestCase {

  /**
   * Tests storing and retrieving cache items.
   */
  public function testStoreRetrieveCacheItem(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "store_retrieve_cache_item_$id";

        if ($this->assertCacheItemSaved($bin, $cid, $data['value'])) {
          $stored[$cid] = $data;
        }
      }

      $message = 'New items were stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        foreach ($stored as $cid => $data) {
          $this->assertCacheItem($bin, $cid, array('value' => $data['value']));
        }
      }
    }
  }

  /**
   * Tests storing and retrieving cache items with a delay.
   */
  public function testStoreDelayRetrieveCacheItem(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "store_delay_retrieve_cache_item_$id";

        if ($this->assertCacheItemSaved($bin, $cid, $data['value'], $data['ttl'])) {
          $stored[$cid] = $data;
        }
      }

      $message = 'New items were stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        // Add 2 seconds to the maximum TTL
        // ApcStorageCacheBaseTestCase::storageData() sets to be sure that
        // non-permanent values are purged when the cache is read.
        $message = format_string('The test will be halted for @delay seconds.', array('@delay' => 10));

        $this->pass($message);
        sleep(10);

        foreach ($stored as $cid => $data) {
          if (!empty($data['ttl'])) {
            $this->assertNoCacheItem($bin, $cid);
          }
          else {
            $this->assertCacheItem($bin, $cid, array('value' => $data['value']));
          }
        }
      }
    }
  }

  /**
   * Tests storing cache items and retrieving them via cache_get_multiple().
   */
  public function testStoreRetrieveMultipleCacheItems(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "store_retrieve_cache_item_$id";

        // The TTL set by
        // ApcStorageCacheStoreAndRetrieveTestCase::storageData() is ignored.
        // All the cache items are permanent.
        if ($this->assertCacheItemSaved($bin, $cid, $data['value'])) {
          $stored[] = $cid;
        }
      }

      $message = 'New items were stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        foreach (array_chunk($stored, 3) as $chunk) {
          $this->assertCacheItems($bin, ...$chunk);
        }
      }
    }
  }

  /**
   * Tests storing cache items and retrieving them via cache_get_multiple().
   */
  public function testStoreDelayRetrieveMultipleCacheItems(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "store_retrieve_cache_item_$id";

        if ($this->assertCacheItemSaved($bin, $cid, $data['value'], $data['ttl'] + 2)) {
          $stored[] = $cid;
        }
      }

      $message = 'New items were stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        // 12 is the maximum TTL set by
        // ApcStorageCacheStoreAndRetrieveTestCase::storageData(),
        // plus 2 to make the permanent cache items
        // ApcStorageCacheStoreAndRetrieveTestCase::storageData() returns, plus
        // 2 to be sure that all the cached items are purged when
        // cache_get_multiple() is called.
        $message = format_string('The test will be halted for @delay seconds.', array('@delay' => 12));

        $this->pass($message);
        sleep(12);

        foreach (array_chunk($stored, 3) as $chunk) {
          $this->assertNoCacheItems($bin, $stored, ...$chunk);
        }
      }
    }
  }

}

/**
 * Unit tests for cache_clear_all().
 */
class ApcStorageCacheClearTestCase extends ApcStorageCacheBaseTestCase {

  /**
   * Tests cache_clear_all() using a cache ID.
   */
  public function testClearByCid(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "clear_by_cid_$id";

        if ($this->assertCacheItemSaved($bin, $cid, $data['value'])) {
          $stored[] = $cid;
        }
      }

      $message = 'New items have been stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        $cleared_cid = array_pop($stored);
        $options = array('message' => '@id was removed by cache_clear_all().');

        cache_clear_all($cleared_cid, $bin);

        $this->assertNoCacheItem($bin, $cleared_cid, $options);

        $options = array('message' => '@id was not removed by cache_clear_all().');

        foreach ($stored as $cid) {
          $this->assertCacheItem($bin, $cid, $options);
        }
      }
    }
  }

  /**
   * Tests cache_clear_all() using * as cache ID.
   */
  public function testClearStar(): void {
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($this->storageData() as $id => $data) {
        $cid = "clear_by_star_$id";

        if ($this->assertCacheItemSaved($bin, $cid, $data['value'])) {
          $stored[] = $cid;
        }
      }

      $message = 'New items have been stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        $options = array('message' => '@id was not removed by cache_clear_all().');

        cache_clear_all('*', $bin);

        // Since cache_clear_all() was not called with TRUE as last parameter,
        // '*' is the literal value for the cache ID. No cache item is stored
        // with that cache ID, so all the cache items still exist.
        foreach ($stored as $cid) {
          $this->assertCacheItem($bin, $cid, $options);
        }

        cache_clear_all('*', $bin, TRUE);

        $options = array('message' => '@id was removed by cache_clear_all().');

        // Since cache_clear_all() was called with TRUE as last parameter, all
        // the cache items were removed.
        foreach ($stored as $cid) {
          $this->assertNoCacheItem($bin, $cid, $options);
        }
      }
    }
  }

  /**
   * Tests cache_clear_all() passing TRUE as last parameter.
   */
  public function testClearWildcard(): void {
    $cache_id_prefixes = array('clear_first_time_by_wildcard_', 'clear_second_time_by_wildcard_');
    $stored = array();

    if ($this->skipTest) {
      return;
    }

    if ($this->assertApcuEmpty() && $this->assertCacheBinsOnApcu()) {
      $bin = $this->getCacheBins()[0];

      foreach ($cache_id_prefixes as $prefix) {
        foreach ($this->storageData() as $id => $data) {
          $cid = "$prefix$id";

          if ($this->assertCacheItemSaved($bin, $cid, $data['value'])) {
            $stored[] = $cid;
          }
        }
      }

      $message = 'New items were stored in the cache.';

      if ($this->assertTrue(!empty($stored), $message)) {
        cache_clear_all($cache_id_prefixes[0], $bin, TRUE);

        foreach ($stored as $cid) {
          if (str_starts_with($cid, $cache_id_prefixes[0])) {
            $options = array('message' => '@id was removed by cache_clear_all().');

            $this->assertNoCacheItem($bin, $cid, $options);
          }
          else {
            $options = array('message' => '@id was not removed by cache_clear_all().');

            $this->assertCacheItem($bin, $cid, $options);
          }
        }

        $options = array('message' => '@id was removed by cache_clear_all().');

        cache_clear_all($cache_id_prefixes[1], $bin, TRUE);

        foreach ($stored as $cid) {
          $this->assertNoCacheItem($bin, $cid, $options);
        }
      }
    }
  }

}
