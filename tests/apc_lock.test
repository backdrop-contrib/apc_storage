<?php

/**
 * @file
 * Contains ApcLockTestCase.
 */

declare(strict_types=1);

require_once __DIR__ . '/apc_test_base.class.inc';

/**
 * Tests for the lock implementation.
 */
class ApcLockTestCase extends ApcTestBase {

  /**
   * The names of the locks used by tests.
   *
   * @var array
   */
  protected array $lockNames = array();

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      ApcStorageLock::releaseAll();
    }

    parent::tearDown();
  }

  /**
   * Initializes a set of locks with random names.
   *
   * @return bool
   *   TRUE if all the locks have been created, FALSE otherwise.
   */
  protected function initLocks(): bool {
    $this->lockNames = array();

    for ($i = 0; $i < 4; $i++) {
      $this->lockNames[] = 'lock_' . $this->randomName();
    }

    $count = 0;

    foreach ($this->lockNames as $name) {
      ApcStorageLock::get($name);
      $count++;
    }

    return $this->assertEqual($count, count($this->lockNames),
      'All the locks have been created/retrieved.');
  }

  /**
   * Acquires a set of locks with random timeouts between the specified bounds.
   *
   * @param float $timeout
   *   The timeout.
   */
  protected function acquireLocks(float $timeout): void {
    foreach ($this->lockNames as $name) {
      $lock = ApcStorageLock::get($name);
      $message = format_string(
        'The @name lock has been acquired for @timeout seconds.',
        array('@name' => $name, '@timeout' => (int) round($timeout))
      );
      $this->assertTrue($lock->acquire($timeout), $message);
    }
  }

  /**
   * Tests that locks are acquired and expire after the set timeout.
   */
  public function testAcquireLock(): void {
    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $this->acquireLocks(8.0);
      $delay = 2;
      $this->pass(format_string('Tests will be halted for @delay seconds.', array('@delay' => $delay)));
      sleep($delay);

      foreach ($this->lockNames as $name) {
        $lock = ApcStorageLock::get($name);
        $message = format_string(
          'The @name lock is not available after @delay seconds.',
          array('@name' => $name, '@delay' => $delay)
        );
        $this->assertFalse($lock->maybeAvailable(), $message);
      }

      $delay = 7;
      $this->pass(format_string('Tests will be halted for @delay seconds.', array('@delay' => $delay)));
      sleep($delay);

      $available_count = 0;
      foreach ($this->lockNames as $name) {
        $lock = ApcStorageLock::get($name);
        $message = format_string(
          'The @name lock is available after further @delay seconds.',
          array('@name' => $name, '@delay' => $delay)
        );
        if ($this->assertTrue($lock->maybeAvailable(), $message)) {
          $available_count++;
        }
      }

      $message = 'All the acquired locks are now available.';
      $this->assertTrue(count($this->lockNames) == $available_count, $message);
    }
  }

  /**
   * Tests that ApcStorageLock::wait() works correctly.
   */
  public function testWait(): void {
    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $this->acquireLocks(2.0);
      $lock = ApcStorageLock::get($this->lockNames[0]);
      $message = format_string(
        'The @name lock is available after waiting for @timeout seconds.',
        array('@name' => $this->lockNames[0], '@timeout' => 2)
      );
      $this->assertFalse($lock->wait(2.0), $message);
    }
  }

  /**
   * Tests that ApcStorageLock::release() works correctly.
   *
   * After ApcStorageLock::release() has been called,
   * ApcStorageLock::maybeAvailable() will return TRUE.
   */
  public function testRelease(): void {
    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $this->acquireLocks(4.0);
      foreach ($this->lockNames as $name) {
        $lock = ApcStorageLock::get($name);
        $lock->release();
      }
      $count = 0;
      foreach ($this->lockNames as $name) {
        $lock = ApcStorageLock::get($name);
        $message = format_string(
          'The @name lock is available after it has been released.',
          array('@name' => $name)
        );
        if ($this->assertTrue($lock->maybeAvailable(), $message)) {
          $count++;
        }
      }
      $message = 'All the acquired locks are available after they have been released.';
      $this->assertTrue($count == count($this->lockNames), $message);
    }
  }

  /**
   * Tests that ApcStorageLock::releaseAll() works correctly.
   *
   * After ApcStorageLock::releaseAll() has been called,
   * ApcStorageLock::maybeAvailable() will return FALSE.
   */
  public function testReleaseAll(): void {
    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $this->acquireLocks(4.0);
      ApcStorageLock::releaseAll();
      $count = 0;

      foreach ($this->lockNames as $name) {
        $lock = ApcStorageLock::get($name);
        $message = format_string("The @name lock is available.", array('@name' => $name));
        if ($this->assertTrue($lock->maybeAvailable(), $message)) {
          $count++;
        }
      }

      $message = 'All the acquired locks are available after they have been released.';
      $this->assertTrue($count == count($this->lockNames), $message);
    }
  }

}
