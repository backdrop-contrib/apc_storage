<?php

/**
 * @file
 * Test classes for the Alternative PHP Cache module.
 */

/**
 * Base class for the Alternative PHP Cache tests.
 */
class ApcCacheTestCase extends DrupalWebTestCase {

  /**
   * The cache bins to store on APCu.
   *
   * @var array
   */
  protected $cacheBins = array('apc_cache');

  /**
   * The modules to enable.
   *
   * @var array
   */
  protected $modules = array('apc');

  /**
   * Adds cache bins to the list of cache bins that are stored on APCu.
   *
   * @param string ...$bins
   *   The cache bins to add.
   */
  protected function setCacheBins(...$bins) {
    $this->cacheBins = array_unique(array_merge($this->cacheBins, $bins));
  }

  /**
   * Retrieves the cache bins stored on APCu.
   *
   * @param bool $ignore_first
   *   (optional) Whether to ignore the first cache bin, which is the default
   *   cache bin used from tests. Defaults to FALSE.
   *
   * @return array
   *   The cache bins stored on APCu.
   */
  protected function getCacheBins($ignore_first = FALSE) {
    $cache_bins = $this->cacheBins;

    if ($ignore_first) {
      array_shift($cache_bins);
    }

    return $cache_bins;
  }

  /**
   * Adds modules to the list of modules to enable.
   *
   * @param string ...$modules
   *   The modules to enable.
   */
  protected function setModules(...$modules) {
    $this->modules = array_unique(array_merge($this->modules, $modules));
  }

  /**
   * {@inheritdoc}
   */
  protected function setUp() {
    parent::setUp($this->modules);

    foreach ($this->cacheBins as $bin) {
      variable_set("cache_class_$bin", 'DrupalApcCache');
    }
  }

  /**
   * {@inheritdoc}
   */
  protected function tearDown() {
    if (extension_loaded('apcu') && apcu_enabled()) {
      if (class_exists('APCUIterator')) {
        // Delete the values created by ApcCacheTestCase::assertApcuWritable().
        $iterator = new APCUIterator('/^ApcCacheTestCase:::/', APC_ITER_KEY);
        apcu_delete($iterator);

        // Delete the values created by DrupalApcCache.
        $iterator = new APCUIterator('/^apc_cache::/', APC_ITER_KEY);
        apcu_delete($iterator);
      }
    }
  }

  /**
   * Asserts that the APCu extension is loaded and enabled.
   *
   * @return bool
   *   TRUE if the APCu extension is loaded and enabled, FALSE otherwise.
   */
  protected function assertApcuEnabled() {
    $message = 'The APCu extension has been loaded.';

    if ($this->assertTrue(extension_loaded('apcu'), $message)) {
      return $this->assertTrue(apcu_enabled(), 'The APCu extension is enabled.');
    }

    return FALSE;
  }

  /**
   * Asserts that it is possible to store values in APCu.
   *
   * @return bool
   *   TRUE if the values stored in APCu are the expected ones, FALSE otherwise.
   */
  protected function assertApcuWritable() {
    $values = array(
      'ApcCacheTestCase:::' . $this->randomName() => $this->randomString(),
      'ApcCacheTestCase:::' . $this->randomName() => $this->randomString(),
      'ApcCacheTestCase:::' . $this->randomName() => $this->randomString(),
      'ApcCacheTestCase:::' . $this->randomName() => $this->randomString(),
    );

    foreach ($values as $key => $value) {
      $message = format_string(
        'The @value value for @key has been added.',
        array('@key' => $key, '@value' => $value)
      );
      $success = apcu_store($key, $value);

      if (!$this->assertTrue($success, $message)) {
        return FALSE;
      }
    }

    // Wait nine seconds, to ensure the stored values persist.
    sleep(9);

    foreach ($values as $key => $value) {
      $message = format_string(
        'The value of @key has been retrieved from the cache.',
        array('@key' => $key)
      );
      $retrieved_value = apcu_fetch($key, $success);

      if ($this->assertTrue($success, $message)) {
        $message = format_string(
          'The retrieved value for @key is the expected one (@value).',
          array('@key' => $key, '@value' => $value)
        );

        if (!$this->assertIdentical($retrieved_value, $value, $message)) {
          return FALSE;
        }
      }
      else {
        return FALSE;
      }

      return TRUE;
    }
  }

  /**
   * Asserts that all the cache bins used by tests are stored on APCu.
   *
   * @return bool
   *   FALSE if any cache bin is not stored on APCu, TRUE otherwise.
   */
  protected function assertCacheBinsOnApcu() {
    $result = TRUE;

    foreach ($this->getCacheBins() as $bin) {
      $backend = _cache_get_object($bin);
      $message = format_string(
        'Data for the @bin cache bin is stored on APCu.',
        array('@bin' => $bin)
      );

      if (!$this->assertTrue($backend instanceof DrupalApcCache, $message)) {
        $result = FALSE;
      }
    }

    return $result;
  }

  /**
   * Asserts a cache item exists.
   *
   * @param string $bin
   *   The cache bin.
   * @param string $cid
   *   The cache ID.
   * @param string $value
   *   The value the cache should contain, or NULL if the value is not relevant.
   *
   * @return bool
   *   TRUE if the cache item exists, FALSE otherwise.
   */
  protected function assertCacheItem($bin, $cid, $value = NULL) {
    $item = cache_get($cid, $bin);
    $message = format_string(
      'The value of @bin/@cache_id has been retrieved from the cache.',
      array('@bin' => $bin, '@cache_id' => $cid)
    );

    if ($this->assertNotIdentical($item, FALSE, $message)) {
      $message = format_string(
        '@bin/@cache_id was correctly stored in the cache.',
        array('@bin' => $bin, '@cache_id' => $cid)
      );

      if ($this->assertTrue(is_object($item) && isset($item->data), $message)) {
        if (!is_null($value)) {
          $message = format_string(
            'The value of @bin/@cache_id is the expected value (@value).',
            array('@bin' => $bin, '@cache_id' => $cid, '@value' => $value)
          );
          return $this->assertIdentical($item->data, $value, $message);
        }
      }
    }

    return FALSE;
  }

  /**
   * Asserts a cache item does not exist.
   *
   * @param string $bin
   *   The cache bin.
   * @param string $cid
   *   The cache ID.
   *
   * @return bool
   *   TRUE if the cache item does not exist, FALSE otherwise.
   */
  protected function assertNoCacheItem($bin, $cid) {
    $message = format_string(
      '@bin/@cache_id was not found in the cache.',
      array('@bin' => $bin, '@cache_id' => $cid)
    );

    return $this->assertFalse(cache_get($cid, $bin), $message);
  }

  /**
   * Asserts two or more cache items exist.
   *
   * This method calls cache_get_multiple() to retrieve the items.
   *
   * @param string $bin
   *   The cache bin.
   * @param array $cids
   *   An array containing the cache IDs to retrieve.
   * @param array $values
   *   An array containing the cache values. If a value is irrelevant, use NULL.
   *
   * @return bool
   *   TRUE if all the cache items exist, FALSE otherwise.
   */
  protected function assertCacheItems($bin, $cids, $values) {
    // cache_get_multiple() gets $cids by reference. To avoid it alters this
    // method's $cids parameter, pass it a copy.
    $cache_ids = $cids;
    $items = cache_get_multiple($cache_ids, $bin);

    foreach ($values as $id => $value) {
      $cid = $cids[$id];
      $message = format_string(
        'The value of @bin/@cache_id has been retrieved from the cache.',
        array('@bin' => $bin, '@cache_id' => $cid)
      );

      if ($this->assertTrue(isset($items[$cid]), $message)) {
        $message = format_string(
          '@bin/@cache_id was correctly stored in the cache.',
          array('@bin' => $bin, '@cache_id' => $cid)
        );

        if ($this->assertTrue(is_object($items[$cid]) && isset($items[$cid]->data), $message)) {
          if (!is_null($value)) {
            $message = format_string(
              'The value of @bin/@cache_id is the expected one.',
              array('@bin' => $bin, '@cache_id' => $cid)
            );

            if (!$this->assertIdentical($items[$cid]->data, $value, $message)) {
              return FALSE;
            }
          }
        }
        else {
          return FALSE;
        }
      }
      else {
        return FALSE;
      }
    }

    return TRUE;
  }

  /**
   * Asserts two or more cache items do not exist.
   *
   * This method calls cache_get_multiple() to retrieve the items.
   *
   * @param string $bin
   *   The cache bin.
   * @param array $cids
   *   An array containing the cache IDs to retrieve.
   * @param array $non_existent_cids
   *   An array containing the cache IDs that should not exist.
   *
   * @return bool
   *   TRUE if the assertion succeeded, FALSE otherwise.
   */
  protected function assertNoCacheItems($bin, $cids, $non_existent_cids) {
    // cache_get_multiple() gets $cids by reference. To avoid it alters this
    // method's $cids parameter, pass it a copy.
    $cache_ids = $cids;
    $items = cache_get_multiple($cache_ids, $bin);

    foreach ($non_existent_cids as $cid) {
      $message = format_string(
        '@bin/@cache_id was not found in the cache.',
        array('@bin' => $bin, '@cache_id' => $cid)
      );

      if (!$this->assertFalse(isset($items[$cid]), $message)) {
        return FALSE;
      }
    }

    return TRUE;
  }

}

/**
 * Tests saving and retrieving data.
 */
class ApcCacheSaveAndRetrieveCase extends ApcCacheTestCase {

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Save and retrieve data',
      'description' => 'Verifies the cached items are correctly saved and the retrieved values are correct.',
      'group' => 'Alternative PHP Cache',
    );
  }

  /**
   * Stores the test data in cache.
   *
   * @param array &$values
   *   The stored data, indexed by ID.
   * @param array $cids
   *   The cache IDs of the stored data.
   */
  private function storeTestData(&$values, &$cids) {
    $cache_bins = $this->getCacheBins();
    $bin = $cache_bins[0];
    $cache_values = array(
      TRUE,
      mt_rand(256, 1024),
      mt_rand(256, 1024) / (float) mt_rand(32, 128),
      $this->randomString(),
      array(
        $this->randomString(),
        array(
          TRUE,
          mt_rand(256, 1024),
          mt_rand(256, 1024) / (float) mt_rand(32, 128),
        ),
      ),
      (object) array(
        $this->randomName() => $this->randomString(),
        $this->randomName() => mt_rand(8, 128),
        $this->randomName() => mt_rand(256, 1024) / (float) mt_rand(32, 128),
        $this->randomName(16) => array(
          TRUE,
          mt_rand(256, 1024),
          mt_rand(256, 1024) / (float) mt_rand(32, 128),
        ),
      ),
    );

    foreach ($cache_values as $id => $data) {
      $cache_id = "test_var_$id";
      $cids[$id] = $cache_id;
      $values[$id] = $data;

      cache_set($cache_id, $data, $bin);
    }
  }

  /**
   * Tests retrieving data.
   */
  protected function testRetrieveData() {
    $cids = array();
    $values = array();

    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];

        $this->storeTestData($values, $cids);

        foreach ($values as $id => $data) {
          if (!$this->assertCacheItem($bin, $cids[$id], $data)) {
            return;
          }
        }
      }
    }
  }

  /**
   * Tests cache_get_multiple().
   */
  public function testRetrieveMultipleValues() {
    $cids = array();
    $values = array();

    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];

        $this->storeTestData($values, $cids);

        if ($this->assertCacheItems($bin, $cids, $values)) {
          cache_clear_all($cids[1], $bin);
          $this->assertNoCacheItem($bin, $cids[1]);
          $this->assertNoCacheItem($bin, 'item_' . $this->randomName());
        }
      }
    }
  }

}

/**
 * Tests the cache clearing methods.
 */
class ApcCacheClearCase extends ApcCacheTestCase {

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Cache clear test',
      'description' => 'Checks the cache is correctly cleared.',
      'group' => 'Alternative PHP Cache',
    );
  }

  /**
   * Tests clearing the cache using a single cache ID without using wildcards.
   */
  public function testClearWithCid() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];

        $value = $this->randomString();
        cache_set('test_cid_clear', $value, $bin);

        if ($this->assertCacheItem($bin, 'test_cid_clear', $value)) {
          cache_clear_all('test_cid_clear', $bin);

          if ($this->assertNoCacheItem($bin, 'test_cid_clear')) {
            $value1 = $this->randomString(16);
            $value2 = $this->randomString(16);
            cache_set('test_cid_clear1', $value1, $bin);
            cache_set('test_cid_clear2', $value2, $bin);
            $result1 = $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
            $result2 = $this->assertCacheItem($bin, 'test_cid_clear2', $value2);

            if ($result1 && $result2) {
              // Since TRUE is not passed as third argument to
              // cache_clear_all(), * is the literal value for the cache ID.
              cache_clear_all('*', $bin);
              // The item whose cache ID is * does not exist. The other items
              // still exist because they have not been cleared.
              $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
              $this->assertCacheItem($bin, 'test_cid_clear2', $value2);
            }
          }
        }
      }
    }
  }

  /**
   * Tests clearing the cache using wildcards.
   */
  public function testClearWithWildcard() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];
        $item3 = $this->randomName(16);

        $value1 = $this->randomString();
        $value2 = $this->randomString();
        $value3 = $this->randomString(16);
        cache_set('test_cid_clear1', $value1, $bin);
        cache_set('test_cid_clear2', $value2, $bin);
        cache_set($item3, $value3, $bin);
        $result1 = $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
        $result2 = $this->assertCacheItem($bin, 'test_cid_clear2', $value2);
        $result3 = $this->assertCacheItem($bin, $item3, $value3);

        if ($result1 && $result2 && $result3) {
          cache_clear_all('*', $bin, TRUE);
          $result1 = $this->assertNoCacheItem($bin, 'test_cid_clear1');
          $result2 = $this->assertNoCacheItem($bin, 'test_cid_clear2');
          $result3 = $this->assertNoCacheItem($bin, $item3);

          if ($result1 && $result2 && $result3) {
            $value1 = $this->randomString(16);
            $value2 = $this->randomString(16);
            cache_set('test_cid_clear1', $value1, $bin);
            cache_set('test_cid_clear2', $value2, $bin);
            $result1 = $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
            $result2 = $this->assertCacheItem($bin, 'test_cid_clear2', $value2);
            $result3 = $this->assertNoCacheItem($bin, $item3);

            if ($result1 && $result2 && $result3) {
              cache_clear_all('test_', $bin, TRUE);
              $this->assertNoCacheItem($bin, 'test_cid_clear1');
              $this->assertNoCacheItem($bin, 'test_cid_clear2');

              // $item3 has been already deleted by the previous call to
              // cache_clear_all('*', $bin, TRUE). The following assertion
              // cannot fail.
              $this->assertNoCacheItem($bin, $item3);
            }
          }
        }
      }
    }
  }

  /**
   * Tests clearing the cache passing more cache IDs.
   */
  public function testClearWithCids() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];
        $item3 = $this->randomName(16);

        $value1 = $this->randomString();
        $value2 = $this->randomString();
        $value3 = $this->randomString();
        cache_set($item3, $value3, $bin);
        cache_set('test_cid_clear2', $value2, $bin);
        cache_set('test_cid_clear1', $value1, $bin);
        $result1 = $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
        $result2 = $this->assertCacheItem($bin, 'test_cid_clear2', $value2);
        $result3 = $this->assertCacheItem($bin, $item3, $value3);

        if ($result1 && $result2 && $result3) {
          cache_clear_all(array('test_cid_clear1', 'test_cid_clear2'), $bin);
          $result1 = $this->assertNoCacheItem($bin, 'test_cid_clear1');
          $result2 = $this->assertNoCacheItem($bin, 'test_cid_clear2');
          $result3 = $this->assertCacheItem($bin, $item3, $value3);

          if ($result1 && $result2 && $result3) {
            $value1 = $this->randomString(16);
            $value2 = $this->randomString(16);
            cache_set('test_cid_clear1', $value1, $bin);
            cache_set('test_cid_clear2', $value2, $bin);
            $result1 = $this->assertCacheItem($bin, 'test_cid_clear1', $value1);
            $result2 = $this->assertCacheItem($bin, 'test_cid_clear2', $value2);

            if ($result1 && $result2) {
              cache_clear_all(array('test_cid_clear1', 'test_cid_clear2', $item3), $bin);
              $this->assertNoCacheItem($bin, 'test_cid_clear1');
              $this->assertNoCacheItem($bin, 'test_cid_clear2');
              $this->assertNoCacheItem($bin, $item3);
            }
          }
        }
      }
    }
  }

}

/**
 * Tests cache_is_empty().
 */
class ApcCacheIsEmptyCase extends ApcCacheTestCase {

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Cache emptiness test',
      'description' => 'Verifies a cache bin is empty after clearing the cache.',
      'group' => 'Alternative PHP Cache',
    );
  }

  /**
   * Tests clearing the cache using a cache ID.
   */
  public function testIsEmpty() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $bin = $cache_bins[0];
        $cid = 'test_temporary';
        $message = format_string(
          '@bin/@cid is not empty.',
          array('@bin' => $bin, '@cid' => $cid)
        );

        cache_set($cid, $this->randomString(), $bin);
        cache_clear_all('*', $bin, TRUE);

        if ($this->assertTrue(cache_is_empty($bin), $message)) {
          $value = $this->randomString(16);
          $cid = 'test_temporary' . $this->randomName();
          $message = format_string(
            '@bin/@cid is not empty.',
            array('@bin' => $bin, '@cid' => $cid)
          );

          cache_set($cid, $value, $bin);
          $result1 = $this->assertCacheItem($bin, $cid, $value);
          $result2 = $this->assertFalse(cache_is_empty($bin), $message);

          if ($result1 && $result2) {
            $message = format_string(
              '@bin/@cid is empty.',
              array('@bin' => $bin, '@cid' => $cid)
            );

            cache_clear_all('test_temporary', $bin);
            $this->assertNoCacheItem($bin, $cid);
            $this->assertTrue(cache_is_empty($bin), $message);
          }
        }
      }
    }
  }

}

/**
 * Tests that values added in APCu from another module are not modified.
 */
class ApcCacheExternalValuesCase extends ApcCacheTestCase {

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'External values test',
      'description' => 'Verifies that values added in APCu from other modules are not deleted nor changed.',
      'group' => 'Alternative PHP Cache',
    );
  }

  /**
   * {@inheritdoc}
   */
  protected function setUp() {
    $this->setModules('apc_write_apcu_test');
    $this->setCacheBins(
      'apc_write_apcu_test',
      'apc_cache::',
      'apc_store::apc_cache',
      'apc_cache::' . $this->randomName(),
      'apc_write_apcu_test' . $this->randomName()
    );

    parent::setUp();
  }

  /**
   * Asserts that external values exist in APCu.
   *
   * This method verifies the keys added from the Write APCu Test module
   * are present.
   *
   * @return bool
   *   TRUE if the external values have been all found, FALSE otherwise.
   */
  protected function assertExternalValuesExist() {
    $message = format_string(
      'The APCu key (@key) added from the test module has been found.',
      array('@key' => 'apc_write_apcu_test::keys')
    );
    $keys = apcu_fetch('apc_write_apcu_test::keys', $success);
    $result = TRUE;

    if ($this->assertTrue($success && is_array($keys), $message)) {
      foreach ($keys as $key) {
        $message = format_string(
          'The APCu key (@key) added from the test module has been found.',
          array('@key' => $key)
        );
        $value = apcu_fetch($key, $success);

        if (!$this->assertTrue($success && is_string($value), $message)) {
          $result = FALSE;
        }
      }
    }
    else {
      return FALSE;
    }

    return $result;
  }

  /**
   * Writes some cache items and verifies non-cache values are not overridden.
   */
  public function testWriteCache() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        $cache_bins = $this->getCacheBins();
        $cids = array(
          'test_temporary',
          'test_' . $this->randomName(),
          'apc_write_apcu_test::',
          'apc_write_apcu_test',
          'apc_cache::',
        );

        if ($this->assertExternalValuesExist()) {
          foreach ($cache_bins as $bin) {
            foreach ($cids as $cid) {
              cache_set($cid, $this->randomString(), $bin);
            }
          }

          foreach ($cache_bins as $bin) {
            foreach ($cids as $cid) {
              if (!$this->assertCacheItem($bin, $cid)) {
                return;
              }
            }
          }

          $this->assertExternalValuesExist();
        }
      }
    }
  }

  /**
   * Tests clearing the cache for all cache bins.
   */
  public function testClearingCache() {
    if ($this->assertApcuEnabled() && $this->assertApcuWritable()) {
      if ($this->assertCacheBinsOnApcu()) {
        if ($this->assertExternalValuesExist()) {
          foreach ($this->getCacheBins() as $bin) {
            cache_clear_all('*', $bin, TRUE);
          }

          $this->assertExternalValuesExist();
        }
      }
    }
  }

}
