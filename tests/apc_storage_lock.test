<?php

/**
 * @file
 * Test classes for the APCu lock implementation.
 */

declare(strict_types=1);

use Random\Engine\Xoshiro256StarStar;
use Random\IntervalBoundary;
use Random\Randomizer;
/**
 * Unit tests for the lock implementation.
 *
 * It tests directly the lock class, since it is not possible to include the
 * apc_storage_lock.functions.inc file, which would cause errors about functions
 * already defined.
 */
class ApcStorageLockTestCase extends BackdropWebTestCase {

  /**
   * {@inheritdoc}
   */
  protected $profile = 'testing';

  /**
   * Whether the test should be skipped.
   *
   * @var bool
   */
  protected bool $skipTest = FALSE;

  /**
   * The random engine used by the tests.
   *
   * @var \Random\Engine\Xoshiro256StarStar
   */
  protected Xoshiro256StarStar $engine;

  /**
   * The random generator used by the tests.
   *
   * @var \Random\Randomizer
   */
  protected Randomizer $randomizer;

  /**
   * The locks used from tests.
   *
   * @var ApcStorageLock[]
   */
  protected array $locks;

  /**
   * {@inheritdoc}
   */
  public function setUp(): void {
    if (!extension_loaded('apcu') && !apcu_enabled()) {
      $this->skipTest = TRUE;

      $this->pass('This test only runs when the APCu extension is loaded and enabled.');
    }
    else {
      try {
        $this->engine = new Xoshiro256StarStar(hash('sha256', 'apc_storage_test_' . hrtime(TRUE), TRUE));
        $this->randomizer = new Randomizer($this->engine);
      }
      catch (ValueError) {
        // This exception should never be thrown because the seed passed to
        // Random\Engine\Xoshiro256StarStar::__construct() is surely 32 bytes
        // and those are not all zeros.
      }
    }

    parent::setUp(array('apc_storage'));
  }

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    parent::tearDown();

    if (extension_loaded('apcu') && apcu_enabled()) {
      ApcStorageLock::releaseAll();
      apcu_clear_cache();
    }
  }

  /**
   * Generates a random floating-point number between two values.
   *
   * @param float $from
   *   The lower bound of the range.
   * @param float $to
   *   The upper bound of the range.
   *
   * @return float
   *   The randomly generated floating-point number.
   */
  protected function randomFloat(float $from = 1.0, float $to = 8.0): float {
    try {
      $min = min($from, $to);
      $max = max($from, $to);

      if ($min === $max) {
        return $min;
      }

      return $this->randomizer->getFloat(1.0, 8.0, IntervalBoundary::ClosedClosed);
    }
    catch (ValueError) {
      // This exception should never be thrown.
    }
  }

  /**
   * Generates a random integer between two values.
   *
   * @param int $from
   *   The lower bound of the range.
   * @param int $to
   *   The upper bound of the range.
   *
   * @return int
   *   The randomly generated integer.
   */
  protected function randomInt(int $from = 128, int $to = 65536): int {
    try {
      $min = min($from, $to);
      $max = max($from, $to);

      if ($min === $max) {
        return $min;
      }

      return $this->randomizer->getInt($min, $max);
    }
    catch (ValueError) {
      // This exception should never be thrown.
    }
  }

  /**
   * Returns a parsable string representation of a variable.
   *
   * This method is similar to drupal_var_export(), but it accepts a single
   * argument, and it outputs an array on a single line.
   *
   * @param mixed $var
   *   The variable to export.
   *
   * @return string
   *   The exported variable.
   */
  protected static function varExport(mixed $var): string {
    if (is_array($var)) {
      if (empty($var)) {
        $output = 'array()';
      }
      else {
        // Don't export keys if the array is non-associative.
        $export_keys = array_values($var) != $var;
        $output = 'array(';

        foreach ($var as $key => $value) {
          $output .= ($export_keys ? self::varExport($key) . ' => ' : '') . self::varExport($value) . ', ';
        }

        $output = rtrim($output, ', ') . ')';
      }
    }
    elseif (is_bool($var)) {
      $output = $var ? 'TRUE' : 'FALSE';
    }
    elseif (is_string($var)) {
      if (str_contains($var, "\n") || str_contains($var, "'")) {
        // If the string contains a line break or a single quote, use the
        // double quote export mode. Encode backslash and double quotes and
        // transform some common control characters.
        $var = str_replace(array('\\', '"', "\n", "\r", "\t"), array('\\\\', '\"', '\n', '\r', '\t'), $var);
        $output = '"' . $var . '"';
      }
      else {
        $output = "'" . $var . "'";
      }
    }
    else {
      $output = var_export($var, TRUE);
    }

    return $output;
  }

  /**
   * Initializes a set of locks with random names.
   *
   * @return bool
   *   TRUE if all the locks have been created, FALSE otherwise.
   */
  protected function initLocks(): bool {
    $lock_names = array(
      $this->randomName(),
      $this->randomName(),
      $this->randomName(),
    );

    foreach ($lock_names as $lock_name) {
      $this->locks[$lock_name] = ApcStorageLock::get($lock_name);
    }

    if ($this->assertEqual(count($this->locks), count($lock_names), 'All the locks have been created.')) {
      return TRUE;
    }

    return FALSE;
  }

  /**
   * Asserts that the APCu storage is empty.
   */
  protected function assertApcuEmpty(): bool {
    $iterator = new APCUIterator('/^.+/', APC_ITER_KEY);

    return $this->assertTrue($iterator->getTotalCount() === 0, 'The APCu storage is empty.');
  }

  /**
   * Asserts that there are APCu keys matching the given prefix.
   *
   * @param string $key
   *   The prefix to search for in APCu keys, excluding the regular expression
   *   delimiters and the ^ anchor.
   * @param array $options
   *   An array of options, which can contain the following keys:
   *     - message: A custom message to display upon assertion.
   *     - regexp: If TRUE, $key is a regular expression that does not need to
   *       be passed to preg_quote().
   *
   * @return bool
   *   TRUE if there are APCu keys matching the prefix, FALSE otherwise.
   */
  protected function assertApcuKeysByPrefix(string $key, array $options = array()): bool {
    $options += array(
      'message' => 'There are APCu keys matching @key.',
      'regexp' => FALSE,
    );
    $escaped_key = $options['regexp'] ? $key : preg_quote($key, '/');
    $iterator = new APCUIterator("/^$escaped_key/", APC_ITER_KEY);
    $message = format_string(
      $options['message'],
      array('@key' => $this->varExport("/^$escaped_key/"))
    );

    return $this->assertTrue($iterator->getTotalCount() > 0, $message);
  }

  /**
   * Asserts that there are no APCu keys matching the given prefix.
   *
   * @param string $key
   *   The prefix to search for in APCu keys, excluding the regular expression
   *   delimiters and the ^ anchor.
   * @param array $options
   *   An array of options, which can contain the following keys:
   *     - message: A custom message to display upon assertion.
   *     - regexp: If TRUE, $key is a regular expression that does not need to
   *       be passed to preg_quote().
   *
   * @return bool
   *   TRUE if there are no APCu keys matching the prefix, FALSE otherwise.
   */
  protected function assertNoApcuKeysByPrefix(string $key, array $options = array()): bool {
    $options += array(
      'message' => 'There are no APCu keys matching @key.',
      'regexp' => FALSE,
    );
    $escaped_key = $options['regexp'] ? $key : preg_quote($key, '/');
    $iterator = new APCUIterator("/^$escaped_key/", APC_ITER_KEY);
    $message = format_string(
      $options['message'],
      array('@key' => $this->varExport("/^$escaped_key/"))
    );

    return $this->assertTrue($iterator->getTotalCount() === 0, $message);
  }

  /**
   * Tests that the lock creation works.
   */
  public function testCreateLock(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $this->assertTrue($this->initLocks(), 'All the locks have been created.');

    // Since no lock has been acquired, no APCu key should be created for locks.
    $this->assertNoApcuKeysByPrefix(
      'apc_storage_lock::[a-zA-Z0-9-_]+::',
      array(
        'message' => 'No APCu key has been created for locks.',
        'regexp' => TRUE
      )
    );
  }

  /**
   * Tests that locks are acquired and expire after a maximum of 4 seconds.
   */
  public function testAcquireLockShortTimeout(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $timeouts = array();

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      foreach ($this->locks as $lock) {
        $timeouts[] = $timeout = $this->randomFloat(2.0, 4.0);
        $message = format_string(
          'The lock has been acquired for @timeout seconds.',
          array('@timeout' => $timeout)
        );

        $this->assertTrue($lock->acquire($timeout), $message);
      }

      $this->assertApcuKeysByPrefix(
        '/^apc_storage_lock::[a-zA-Z0-9-_]+::/',
        array(
          'message' => 'Data for all the locks has been stored on the APCu storage.',
          'regexp' => TRUE,
        )
      );

      // Wait for the locks to expire.
      $delay = 5 + $this->randomInt(1, 4);

      $this->pass(format_string('Tests will be halted for @seconds seconds.', array('@seconds' => $delay)));
      sleep($delay);

      for ($i = 0; $i < count($timeouts); $i++) {
        $message = format_string(
          'The lock is available after a timeout of @timeout seconds.',
          array('@timeout' => $timeouts[$i])
        );

        $this->assertTrue($this->locks[$i]->maybeAvailable(), $message);
      }

    }
  }

  /**
   * Tests that locks are acquired and expire after a maximum of 4 seconds.
   */
  public function testAcquireLockLongTimeout(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $timeouts = array();

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      foreach ($this->locks as $lock) {
        $timeouts[] = $timeout = $this->randomFloat(40.0, 60.0);
        $message = format_string(
          'The lock has been acquired for @timeout seconds.',
          array('@timeout' => $timeout)
        );

        $this->assertTrue($lock->acquire($timeout), $message);
      }

      $this->assertApcuKeysByPrefix(
        '/^apc_storage_lock::[a-zA-Z0-9-_]+::/',
        array(
          'message' => 'Data for all the locks has been stored on the APCu storage.',
          'regexp' => TRUE,
        )
      );

      // Wait for the locks to expire.
      $delay = 54 + $this->randomInt(6, 15);

      $this->pass(format_string('Tests will be halted for @seconds seconds.', array('@seconds' => $delay)));
      sleep($delay);

      for ($i = 0; $i < count($timeouts); $i++) {
        $message = format_string(
          'The lock is available after a timeout of @timeout seconds.',
          array('@timeout' => $timeouts[$i])
        );

        $this->assertTrue($this->locks[$i]->maybeAvailable(), $message);
      }
    }

  }

  public function testAcquireLockTwice(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $timeouts = array();

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      foreach ($this->locks as $lock) {
        $timeouts[] = $timeout = $this->randomFloat(30.0, 45.0);

        $message = format_string(
          'The lock has been acquired for @timeout seconds.',
          array('@timeout' => $timeout)
        );

        $this->assertTrue($lock->acquire($timeout), $message);
      }

      $this->assertApcuKeysByPrefix(
        '/^apc_storage_lock::[a-zA-Z0-9-_]+::/',
        array(
          'message' => 'Data for all the locks has been stored on the APCu storage.',
          'regexp' => TRUE,
        )
      );

      // Wait for 6-9 seconds.
      $delay = 5 + $this->randomInt(1, 4);

      $this->pass(format_string('Tests will be halted for @seconds seconds.', array('@seconds' => $delay)));
      sleep($delay);

      for ($i = 0; $i < count($this->locks); $i++) {
        $message = format_string(
          'The lock is still not available after @delay seconds.',
          array('@delay' => $delay)
        );

        $this->assertFalse($this->locks[$i]->maybeAvailable(), $message);
      }

      foreach ($this->locks as $lock) {
        $timeouts[] = $timeout = $this->randomFloat(45.0, 60.0);

        $message = format_string(
          'The lock has been acquired for @timeout seconds.',
          array('@timeout' => $timeout)
        );

        $this->assertTrue($lock->acquire($timeout), $message);
      }

      $delay = (int) max($timeouts) + 10;

      $this->pass(format_string('Tests will be halted for @seconds seconds.', array('@seconds' => $delay)));
      sleep($delay);

      for ($i = 0; $i < count($timeouts); $i++) {
        $message = format_string(
          'The lock is available after a timeout of @timeout seconds.',
          array('@timeout' => $timeouts[$i])
        );

        $this->assertTrue($this->locks[$i]->maybeAvailable(), $message);
      }
    }
  }

  public function testWaitForLock(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $timeouts = array();

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      foreach ($this->locks as $lock) {
        $timeouts[] = $timeout = $this->randomFloat(20.0, 40.0);
        $message = format_string(
          'The lock has been acquired for @timeout seconds.',
          array('@timeout' => $timeout)
        );

        $this->assertTrue($lock->acquire($timeout), $message);
      }

      $timeout = max($timeouts) + 10.0;
      $message = format_string(
        'The lock is available after a timeout of @timeout seconds.',
        array('@timeout' => $timeout)
      );
      $this->assertFalse($this->locks[0]->waitForLock($timeout), $message);
    }
  }

}
