<?php

/** @noinspection PhpUnused */

/**
 * @file
 * Contains ApcLockTestCase.
 */

declare(strict_types=1);

use apc_storage\lock\Lock;

require_once __DIR__ . '/apc_test_base.class.inc';

/**
 * Tests for the lock implementation.
 *
 * @testClass
 */
class ApcLockTestCase extends ApcTestBase {

  /**
   * The locks used by tests.
   *
   * @var \apc_storage\lock\Lock[]
   */
  protected array $locks = [];

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      Lock::releaseAll();
    }

    parent::tearDown();
  }

  /**
   * Initializes a set of locks with random names.
   *
   * @return void
   *   TRUE if all the locks have been created, FALSE otherwise.
   */
  protected function initLocks(): void {
    $this->locks = array();

    for ($i = 0; $i < 4; $i++) {
      $this->locks[] = Lock::get($this->randomName());
    }
 }

  /**
   * Acquires a set of locks with random timeouts between the specified bounds.
   *
   * @param float $timeout
   *   The timeout.
   *
   * @return bool
   *   TRUE if all the locks have been acquired, FALSE otherwise.
   */
  protected function acquireLocks(float $timeout): bool {
    $result = TRUE;

    foreach ($this->locks as $lock) {
      $acquired = $lock->acquire($timeout);
      $result = $result && $acquired;
    }

    return $result;
  }

  protected function assertLockAcquired(Lock $lock, string $message): bool {
    if (!apcu_exists($lock->keyName)) {
      $result = FALSE;
    }
    else {
      $data = apcu_fetch($lock->keyName, $success);

      if ($success) {
        $result = (!empty($data['expire']) && microtime(TRUE) < (float) $data['expire']);
      }
      else {
        $result = FALSE;
      }
    }

    $this->assert($result, $message);

    return $result;
  }

  protected function assertLockAvailable(Lock $lock, string $message): bool {
    return $this->assert($lock->maybeAvailable(), $message);
  }

  protected function assertLockNotAvailable(Lock $lock, string $message): bool {
    return $this->assert($lock->maybeAvailable() == FALSE, $message);
  }

  /**
   * Tests that locks are acquired and expire after the set timeout.
   */
  public function testAcquireLocks(): void {
    $count = 0;
    $delay = 2;
    $messages = [
      'All the locks have been acquired.',
      'Tests will be halted for @delay seconds.',
      'The @name lock is not available after @delay seconds.',
      'None of the acquired locks is available before the acquire timeout expires.',
      'The @name lock is available after further @delay seconds.',
      'All the acquired locks are available after the acquire timeout expired.',
    ];
    $timeout = 10.0;

    $this->initLocks();

    if ($this->assertTrue($this->acquireLocks($timeout), $messages[0])) {
      $this->pass(format_string($messages[1], ['@delay' => $delay]));
      sleep($delay);

      foreach ($this->locks as $lock) {
        $message = format_string(
          $messages[2],
          ['@name' => $lock->name, '@delay' => $delay]
        );

        if ($this->assertLockAcquired($lock, $message)) {
          $count++;
        }
      }

      $this->assertTrue($count == count($this->locks), $messages[3]);

      $count = 0;
      $delay = (int) ($timeout - $delay) + 1;

      $this->pass(format_string($messages[1], ['@delay' => $delay]));
      sleep($delay);

      foreach ($this->locks as $lock) {
        $message = format_string(
          $messages[4],
          ['@name' => $lock->name, '@delay' => $delay]
        );

        if ($this->assertLockAvailable($lock, $message)) {
          $count++;
        }
      }

      $this->assertTrue($count == count($this->locks), $messages[5]);
    }
  }

  public function testMaybeAvailable(): void {
    $delay = 2;
    $messages = [
      'All the locks have been acquired with a timeout of @timeout seconds.',
      'Tests will be halted for @delay seconds.',
      'The @name lock is not available after @delay seconds.',
      'The @name lock is available after further @delay seconds.',
    ];
    $timeout = 8.0;

    $this->initLocks();

    $message = format_string($messages[0], ['@timeout' => (int) $timeout]);

    if ($this->assertTrue($this->acquireLocks($timeout), $message)) {
      $this->pass(format_string($messages[1], ['@delay' => $delay]));
      sleep($delay);

      // Verify the locks are not available before the acquire timeout expires.
      foreach ($this->locks as $lock) {
        $message = format_string(
          $messages[2],
          ['@name' => $lock->name, '@delay' => $delay]
        );

        $this->assertLockNotAvailable($lock, $message);
      }

      $delay = (int) ($timeout - $delay) + 1;

      $this->pass(format_string($messages[1], ['@delay' => $delay]));
      sleep($delay);

      // Verify the locks are available after the acquire timeout expires.
      foreach ($this->locks as $lock) {
        $message = format_string(
          $messages[3],
          ['@name' => $lock->name, '@delay' => $delay]
        );

        $this->assertLockAvailable($lock, $message);
      }
    }
  }

  /**
   * Tests that Lock::wait() works correctly.
   */
  public function testWait(): void {
    $lock = $this->locks[0];
    $messages = [
      'All the locks have been acquired.',
      'The @name lock is available after waiting for @timeout seconds.',
    ];
    $timeout = 2.0;

    $this->initLocks();

    if ($this->assertTrue($this->acquireLocks($timeout), $messages[0])) {
      $message = format_string($messages[1], ['@name' => $lock->name, '@timeout' => (int) $timeout + 1]);

      // Lock::wait() returns FALSE when the lock is available.
      $this->assertFalse($lock->wait($timeout + 1.0), $message);
    }
  }

  /**
   * Tests that Lock::release() works correctly.
   *
   * After Lock::release() has been called,
   * Lock::maybeAvailable() will return TRUE.
   */
  public function testRelease(): void {
    $count = 0;
    $delay = 3;
    $messages = [
      'All the locks have been acquired',
      'The @name lock is not available before it is released.',
      'None of the locks are available before they are released.',
      'The @name lock is available after it has been released.',
      'All the acquired locks are available after they have been released.',
      'Tests will be halted for @delay seconds.',
      'Lock::release() has been called for all the locks.'
    ];
    $timeout = 7.0;

    $this->initLocks();

    if ($this->assertTrue($this->acquireLocks($timeout), $messages[0])) {
      foreach ($this->locks as $lock) {
        $message = format_string($messages[1], ['@name' => $lock->name]);

        if ($this->assertLockNotAvailable($lock, $message)) {
          $count++;
        }
      }

      $this->assertTrue($count == count($this->locks), $messages[2]);

      $this->pass(format_string($messages[5], ['@delay' => $delay]));
      sleep($delay);

      foreach ($this->locks as $lock) {
        $lock->release();
      }

      $this->pass($messages[6]);

      $count = 0;

      foreach ($this->locks as $lock) {
        $message = format_string($messages[3], ['@name' => $lock->name]);

        if ($this->assertLockAvailable($lock, $message)) {
          $count++;
        }
      }

      $this->assertTrue($count == count($this->locks), $messages[4]);
    }
  }

  /**
   * Tests that Lock::releaseAll() works correctly.
   */
  public function testReleaseAll(): void {
    $count = 0;
    $delay = 2;
    $messages = [
      'All the locks have been acquired.',
      'Tests will be halted for @delay seconds.',
      'Lock::releaseAll() has been called.',
      'The @name lock is available after Lock::releaseAll() has been called.',
      'All the acquired locks are available after Lock::releaseAll() has been called.',
    ];
    $timeout = 6.0;

    $this->initLocks();

    if ($this->assertTrue($this->acquireLocks($timeout), $messages[0])) {
      $this->pass(format_string($messages[1], ['@delay' => $delay]));
      sleep($delay);

      Lock::releaseAll();
      $this->pass($messages[2]);

      foreach ($this->locks as $lock) {
        $message = format_string($messages[3], ['@name' => $lock->name]);

        if ($this->assertLockAvailable($lock, $message)) {
          $count++;
        }
      }

      $this->assertTrue($count == count($this->locks), $messages[4]);
    }
  }

}
