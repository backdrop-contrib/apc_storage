<?php

/**
 * @file
 * Contains ApcStorageQueueTestCase.
 */

declare(strict_types=1);

require_once __DIR__ . '/apc_storage_base_test.class.inc';

/**
 * Unit tests for queue cron.
 */
class ApcStorageQueueTestCase extends ApcStorageBaseTestCase {

  /**
   * The queues used from tests.
   *
   * @var array
   */
  protected array $queues = array();

  /**
   * {@inheritdoc}
   */
  public function setUp(): void {
    global $settings;

    $this->queues = array(
      'apc_storage_test_first_queue' => (object) array(),
      'apc_storage_test_second_queue' => (object) array(),
      'apc_storage_test_' . $this->randomName() . '_queue' => (object) array(),
    );

    foreach (array_keys($this->queues) as $name) {
      $settings["queue_class_$name"] = 'ApcStorageQueue';
    }

    // The default class for queues is intentionally set to MemoryQueue to
    // avoid the database is used for queue storage.
    $settings['queue_default_class'] = 'MemoryQueue';

    parent::setUp();
  }

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      foreach ($this->queues as $queue) {
        if (isset($queue->instance)) {
          $queue->instance->deleteQueue();
        }
      }
    }

    parent::tearDown();
  }

  /**
   * Initializes the queues used to test the APCu queue implementation.
   *
   * @return bool
   *   TRUE if the queues are successfully initialized, FALSE otherwise.
   */
  protected function initQueues(): bool {
    foreach ($this->queues as $name => $data) {
      $queue = BackdropQueue::get($name);

      if (!$this->assertTrue($queue instanceof ApcStorageQueue, 'The queue is an instance of ApcStorageQueue.')) {
        return FALSE;
      }

      $i = 0;
      $data->items = iterator_to_array($this->storageData());

      foreach ($data->items as $id => $item) {
        $message = format_string(
          'Item @name has been added to the @queue queue.',
          array('@name' => $id, '@queue' => $name),
        );

        if ($this->assertTrue($queue->createItem($item['value']), $message)) {
          $i++;
        }
      }

      $message = format_string(
        'All items have been added to the @queue queue.',
        array('@queue' => $name),
      );

      if (!$this->assertTrue($i == count($data->items), $message)) {
        return FALSE;
      }
    }

    return TRUE;
  }

  /**
   * Tests that queue items are correctly added.
   */
  public function testAddItems(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $message = format_string(
          'Data for the @queue queue has been stored on the APCu storage.',
          array('@queue' => $name),
        );

        $this->assertApcuKeysByPrefix(
          'apc_storage_queue::' . preg_quote($name, '/') . '::[0-9a-f]{64}',
          array('message' => $message, 'regexp' => TRUE),
        );

        $message = format_string(
          'numberOfItems() returns the correct number of items for the @queue queue.',
          array('@queue' => $name),
        );
        $queue = BackdropQueue::get($name);

        $this->assertEqual(
          $queue->numberOfItems(),
          count($data->items),
          $message
        );
      }
    }
  }

  /**
   * Tests that items are correctly claimed from the queue.
   *
   * This test uses a random lease time lower than the default one.
   */
  public function testClaimItem(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      $lease_times = array();

      foreach ($this->queues as $name => $data) {
        $claimed_items = 0;
        $count = count($data->items);
        $queue = BackdropQueue::get($name);

        for ($i = 0; $i < $count + 2; $i++) {
          $lease_times[] = $lease_time = $this->randomInt(5, 10);
          $obj = $queue->claimItem($lease_time);

          if ($i < $count) {
            $message = format_string(
              'An item was claimed from the @queue queue.',
              array('@queue' => $name),
            );

            if ($this->assertTrue(!empty($obj), $message)) {
              $claimed_items++;
            }
          }
          else {
            $message = format_string(
              'No more items were claimed from the @queue queue.',
              array('@queue' => $name),
            );

            $this->assertTrue($obj === NULL, $message);
          }
        }

        $data->claimedItems = $claimed_items;
      }

      $delay = max($lease_times);
      $message = format_string(
        'Tests will be halted for @delay seconds.',
        array('@delay' => $delay),
      );

      $this->pass($message);
      sleep($delay);

      foreach ($this->queues as $name => $data) {
        if (!empty($data->claimedItems)) {
          $count = count($data->items);
          $queue = BackdropQueue::get($name);

          for ($i = 0; $i < $count + 2; $i++) {
            $obj = $queue->claimItem();

            if ($i < $count) {
              $message = format_string(
                'An item was claimed from the @queue queue.',
                array('@queue' => $name),
              );

              $this->assertTrue(!empty($obj), $message);
            }
            else {
              $message = format_string(
                'No more items were claimed from the @queue queue.',
                array('@queue' => $name),
              );

              $this->assertTrue($obj === NULL, $message);
            }
          }
        }
      }
    }
  }

  /**
   * Tests that items are correctly claimed from the queue.
   *
   * This test uses a random lease time higher than the default one.
   */
  public function testClaimItemLongerLeaseTime(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      $lease_times = array();

      foreach ($this->queues as $name => $data) {
        $claimed_items = 0;
        $count = count($data->items);
        $queue = BackdropQueue::get($name);

        for ($i = 0; $i < $count + 1; $i++) {
          $lease_times[] = $lease_time = $this->randomInt(31, 35);
          $obj = $queue->claimItem($lease_time);

          if ($i >= $count) {
            $message = format_string(
              'No more items were claimed from the @queue queue.',
              array('@queue' => $name),
            );

            $this->assertTrue($obj === NULL, $message);
          }
          else {
            $message = format_string(
              'An item was claimed from the @queue queue.',
              array('@queue' => $name),
            );

            if ($this->assertTrue(!empty($obj), $message)) {
              $claimed_items++;
            }
          }
        }

        $data->claimedItems = $claimed_items;
      }

      $delay = max($lease_times);
      $message = format_string(
        'Tests will be halted for @delay seconds.',
        array('@delay' => $delay),
      );

      $this->pass($message);
      sleep($delay);

      foreach ($this->queues as $name => $data) {
        if (!empty($data->claimedItems)) {
          $count = count($data->items);
          $queue = BackdropQueue::get($name);

          for ($i = 0; $i < $count + 1; $i++) {
            $obj = $queue->claimItem();

            if ($i >= $count) {
              $message = format_string(
                'No more items were claimed from the @queue queue.',
                array('@queue' => $name),
              );

              $this->assertTrue($obj === NULL, $message);
            }
            else {
              $message = format_string(
                'An item was claimed from the @queue queue.',
                array('@queue' => $name),
              );

              $this->assertTrue(!empty($obj), $message);
            }
          }
        }
      }
    }
  }

  /**
   * Tests that items cannot be claimed after the queue is deleted.
   */
  public function testDeleteQueue(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $queue = BackdropQueue::get($name);
        $queue->deleteQueue();

        $message = format_string(
          'Data for the @queue queue has been removed from the APCu storage.',
          ['@queue' => $name],
        );

        $this->assertNoApcuKeysByPrefix(
          'apc_storage_queue::' . preg_quote($name, '/') . '::[0-9a-f]{64}',
          ['message' => $message, 'regexp' => TRUE],
        );
      }

      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $queue = BackdropQueue::get($name);

        for ($i = 0; $i < $count + 2; $i++) {
          $obj = $queue->claimItem();

          $message = format_string(
            'No item was claimed from the @queue queue.',
            array('@queue' => $name),
          );

          $this->assertTrue($obj === NULL, $message);
        }
      }
    }
  }

  /**
   * Tests that items can be immediately claimed after they are released.
   */
  public function testReleaseItem(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $queue) {
        $claimed_items = 0;
        $count = count($queue->items);

        for ($i = 0; $i < $count; $i++) {
          $obj = $queue->instance->claimItem();

          $message = format_string(
            'An item was claimed from the @queue queue.',
            array('@queue' => $name),
          );

          if ($this->assertTrue(!empty($obj), $message)) {
            $claimed_items++;

            // Release the item before the lease time is passed.
            $queue->instance->releaseItem($obj);
          }
        }

        $queue->claimedItems = $claimed_items;
      }

      foreach ($this->queues as $name => $queue) {
        if (!empty($queue->claimedItems)) {
          $count = count($queue->items);

          for ($i = 0; $i < $count; $i++) {
            $obj = $queue->instance->claimItem();
            $message = format_string(
              'An item was claimed from the @queue queue.',
              array('@queue' => $name),
            );

            $this->assertTrue(!empty($obj), $message);
          }
        }
      }
    }
  }

}
