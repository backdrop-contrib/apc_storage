<?php

/**
 * @file
 * Hook implementations for the APC Storage module.
 */

/**
 * Implements hook_autoload_info().
 *
 * @hook
 */
function apc_storage_autoload_info(): array {
  return [
    'Cache' => 'includes/cache.class.inc',
    'ChainedCache' => 'includes/chained_cache.class.inc',
    'DatabaseCache' => 'includes/database_cache.class.inc',
    'Lock' => 'includes/lock.class.inc',
    'Queue' => 'includes/queue.class.inc',
  ];
}
