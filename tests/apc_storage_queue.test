<?php

/**
 * @file
 * Contains ApcStorageQueueTestCase.
 */

declare(strict_types=1);

require_once __DIR__ . '/apc_storage_base_test.class.inc';

/**
 * Unit tests for queue cron.
 */
class ApcStorageQueueTestCase extends ApcStorageBaseTestCase {

  /**
   * The queues used from tests.
   *
   * @var array
   */
  protected array $queues = array();

  /**
   * {@inheritdoc}
   */
  public function setUp(): void {
    global $settings;

    $this->queues = array(
      'apc_storage_test_first_queue' => (object) array(),
      'apc_storage_test_second_queue' => (object) array(),
      'apc_storage_test_' . $this->randomName() . '_queue' => (object) array(),
    );

    foreach (array_keys($this->queues) as $name) {
      $settings["queue_class_$name"] = 'ApcStorageQueue';
    }

    // The default class for queues is intentionally set to MemoryQueue to
    // avoid the database is used for queue storage.
    $settings['queue_default_class'] = 'MemoryQueue';

    parent::setUp();
  }

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      foreach ($this->queues as $name => $data) {
        $queue = BackdropQueue::get($name);
        $queue->deleteQueue();
      }
    }

    parent::tearDown();
  }

  /**
   * Initializes the queues used to test the APCu queue implementation.
   *
   * @return bool
   *   TRUE if the queues are successfully initialized, FALSE otherwise.
   */
  protected function initQueues(): bool {
    foreach ($this->queues as $name => $data) {
      $queue = BackdropQueue::get($name);

      if (!$this->assertTrue($queue instanceof ApcStorageQueue, 'The queue is an instance of ApcStorageQueue.')) {
        return FALSE;
      }

      $i = 0;
      $data->items = iterator_to_array($this->storageData());

      foreach ($data->items as $id => $item) {
        $message = format_string(
          'Item @name has been added to the @queue queue.',
          array('@name' => $id, '@queue' => $name),
        );

        if ($this->assertTrue($queue->createItem($item['value']), $message)) {
          $i++;
        }
      }

      $message = format_string(
        'All items have been added to the @queue queue.',
        array('@queue' => $name),
      );

      if (!$this->assertTrue($i == count($data->items), $message)) {
        return FALSE;
      }
    }

    return TRUE;
  }

  /**
   * Tests that queue items are correctly added.
   */
  public function testAddItem(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $message = format_string(
          'Data for the @queue queue has been stored in the APCu storage.',
          array('@queue' => $name),
        );

        $this->assertApcuKeysByPrefix(
          'apc_storage_queue::' . preg_quote($name, '/') . '::[0-9a-f]{64}',
          array('message' => $message, 'regexp' => TRUE),
        );

        $message = format_string(
          'numberOfItems() returns the correct number of items for the @queue queue.',
          array('@queue' => $name),
        );
        $queue = BackdropQueue::get($name);

        $this->assertEqual($queue->numberOfItems(), count($data->items), $message);
      }
    }
  }

  /**
   * Tests that items can be claimed from the queue.
   *
   * This test uses a random lease time lower than the default one.
   */
  public function testClaimItem(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $queue = BackdropQueue::get($name);
        $lease_time = $this->randomInt(5, 10);
        $expire_time = time() + $lease_time;
        $data->claimedItems = 0;

        for ($i = 0; $i < $count; $i++) {
          $obj = $queue->claimItem($lease_time);

          $message = format_string(
            'An item was claimed from the @queue queue.',
            array('@queue' => $name),
          );

          if ($this->assertTrue($obj instanceof stdClass, $message)) {
            $data->claimedItems++;
          }
        }

        $message = format_string(
          'All items have been claimed from the @queue queue.',
          array('@queue' => $name),
        );

        if ($this->assertTrue($data->claimedItems == $count, $message)) {
          $count = 0;
          $obj = $queue->claimItem();
          $message = format_string(
            'It was not possible to claim further items from the @queue queue.',
            array('@queue' => $name),
          );

          if ($this->assertTrue($obj === NULL, $message)) {
            $escaped_name = preg_quote($name, '/');
            $iterator = new APCUIterator("/^apc_storage_queue::$escaped_name::[0-9a-f]{64}/");

            foreach ($iterator as $item) {
              $count++;
              $item_id = str_replace("apc_storage_queue::$name::", '', $item['key']);
              $condition = (
                isset($item['value']->expire) &&
                isset($item['value']->item_id) &&
                 ApcStorageHelper::binaryToHex($item['value']->item_id) == $item_id
              );
              $message = format_string("The data for @queue::@id has been correctly stored.",
                array('@queue' => $name, '@id' => $item_id)
              );

              $this->assertTrue($condition, $message);

              $message = format_string(
                'The expiration time for @queue::@id is correct.',
                array('@queue' => $name, '@id' => $item['value']->item_id)
              );

              $this->assertEqual($item['value']->expire, $expire_time, $message);
            }
          }
        }

        $message = format_string(
          "All the @queue queue's items have been stored in the APCu storage.",
          array('@queue' => $name),
        );

        $this->assertTrue($data->claimedItems == $count, $message);
      }
    }
  }

  /**
   * Tests that items can be immediately claimed after they are released.
   */
  public function testReleaseItem(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $queue = BackdropQueue::get($name);
        $data->claimedItems = 0;
        $data->claimedObjects = array();

        for ($i = 0; $i < $count; $i++) {
          $data->claimedObjects[] = $obj = $queue->claimItem();

          $message = format_string(
            'An item was claimed from the @queue queue.',
            array('@queue' => $name),
          );

          if ($this->assertFalse(is_null($obj), $message)) {
            $data->claimedItems++;
          }
        }

        $message = format_string(
          'All items have been claimed from the @queue queue.',
          array('@queue' => $name),
        );

        if ($this->assertTrue($data->claimedItems == $count, $message)) {
          $obj = $queue->claimItem();
          $message = format_string(
            'It was not possible to claim further items from the @queue queue.',
            array('@queue' => $name),
          );

          $this->assertTrue(is_null($obj), $message);
        }
      }

      // Release all the acquired items before the lease time passed.
      foreach ($this->queues as $name => $data) {
        $queue = BackdropQueue::get($name);

        foreach ($data->claimedObjects as $obj) {
          $queue->releaseItem($obj);
        }
      }

      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $queue = BackdropQueue::get($name);

        for ($i = 0; $i < $count; $i++) {
          $obj = $queue->claimItem();
          $message = format_string(
            'An item was claimed from the @queue queue for the second time.',
            array('@queue' => $name),
          );

          $this->assertFalse(is_null($obj), $message);
        }

        $message = format_string(
          'All items have been claimed from the @queue queue for the second time.',
          array('@queue' => $name),
        );

        if ($this->assertTrue($data->claimedItems == $count, $message)) {
          $obj = $queue->claimItem();
          $message = format_string(
            'It was not possible to claim further items from the @queue queue for the second time.',
            array('@queue' => $name),
          );

          $this->assertTrue(is_null($obj), $message);
        }
      }
    }
  }

  /**
   * Tests that items cannot be claimed after the queue is deleted.
   */
  public function testDeleteQueue(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $queue = BackdropQueue::get($name);
        $queue->deleteQueue();

        $message = format_string(
          'Data for the @queue queue has been removed from the APCu storage.',
          array('@queue' => $name),
        );

        $this->assertNoApcuKeysByPrefix(
          'apc_storage_queue::' . preg_quote($name, '/') . '::[0-9a-f]{64}',
          array('message' => $message, 'regexp' => TRUE),
        );
      }

      foreach ($this->queues as $name => $data) {
        $claimed_items = 0;
        $count = count($data->items);
        $queue = BackdropQueue::get($name);

        for ($i = 0; $i < $count; $i++) {
          $obj = $queue->claimItem();

          if (!is_null($obj)) {
            $claimed_items++;
          }
        }

        $message = format_string(
          'No items were claimed from the @queue queue after it was deleted.',
          array('@queue' => $name),
        );

        $this->assertTrue($claimed_items == 0, $message);
      }
    }
  }

}
