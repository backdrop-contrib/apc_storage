<?php

/**
 * @file
 * Contains ApcStorageLockTestCase.
 */

declare(strict_types=1);

require_once __DIR__ . '/apc_storage_base_test.class.inc';

/**
 * Tests for the lock implementation.
 *
 * It tests directly the lock class, since it is not possible to include the
 * apc_storage_lock.functions.inc file, which would cause errors about functions
 * already defined.
 */
class ApcStorageLockTestCase extends ApcStorageBaseTestCase {

  /**
   * The names of the locks used by tests.
   *
   * @var array
   */
  protected array $lockNames = array();

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      ApcStorageLock::releaseAll();
    }

    parent::tearDown();
  }

  /**
   * Initializes a set of locks with random names.
   *
   * @return bool
   *   TRUE if all the locks have been created, FALSE otherwise.
   */
  protected function initLocks(): bool {
    $this->lockNames = array(
      'lock_' . $this->randomName(),
      'lock_' . $this->randomName(),
      'lock_' . $this->randomName(),
    );
    $count = 0;

    foreach ($this->lockNames as $name) {
      ApcStorageLock::get($name);
      $count++;
    }

    if ($this->assertEqual($count, count($this->lockNames), 'All the locks have been created/retrieved.')) {
      return TRUE;
    }

    return FALSE;
  }

  /**
   * Acquires a set of locks with random timeouts between the specified bounds.
   *
   * @param float $from
   *   The lower bound of the timeout range.
   * @param float $to
   *   The upper bound of the timeout range.
   *
   * @return float
   *   The maximum timeout value used for acquiring the locks.
   */
  protected function acquireLocks(float $from, float $to): float {
    $timeouts = array();

    foreach ($this->lockNames as $name) {
      $lock = ApcStorageLock::get($name);
      $timeouts[] = $timeout = $this->randomFloat($from, $to);
      $message = format_string(
        'The @name lock has been acquired for @timeout seconds.',
        array('@name' => $name, '@timeout' => (int) round($timeout))
      );

      $this->assertTrue($lock->acquire($timeout), $message);
    }

    return max($timeouts);
  }

  /**
   * Tests that the lock creation works.
   */
  public function testCreateLock(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    $this->assertTrue($this->initLocks(), 'All the locks have been created.');

    // Since no lock has been acquired, no APCu key should be created for locks.
    $this->assertNoApcuKeysByPrefix(
      'apc_storage_lock::[a-zA-Z0-9-_]+::',
      array(
        'message' => 'No APCu key has been created for locks.',
        'regexp' => TRUE
      )
    );
  }

  /**
   * Tests that locks are acquired and expire after the set timeout.
   */
  public function testAcquireLock(): void {
    $locks = array();

    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $max_timeout = $this->acquireLocks(12.0, 16.0);
      $delay = (int) ($max_timeout / 4);

      foreach ($this->lockNames as $name) {
        $locks[$name] = $lock =ApcStorageLock::get($name);
        $message = format_string(
          'Data for the @name lock has been stored in the APCu storage.',
          array('@name' => $name)
        );

        $this->assertTrue(apcu_exists($lock->keyName()), $message);
      }

      $this->pass(format_string('Tests will be halted for @delay seconds.', array('@delay' => $delay)));
      sleep($delay);

      foreach ($locks as $name => $lock) {
        $message = format_string(
          'The @name lock is not available after @delay seconds.',
          array('@name' => $name, '@delay' => $delay)
        );

        $this->assertFalse($lock->maybeAvailable(), $message);
      }

      $delay = (int) ($max_timeout - $delay) + 1;

      $this->pass(format_string('Tests will be halted for @delay seconds.', array('@delay' => $delay)));
      sleep($delay);

      $count = 0;

      foreach ($locks as $name => $lock) {
        $message = format_string(
          'The @name lock is available after further @delay seconds.',
          array('@name' => $name, '@delay' => $delay)
        );

        if ($this->assertTrue($lock->maybeAvailable(), $message)) {
          $count++;
        }
      }

      if ($count == count($this->lockNames)) {
        $this->assertNoApcuKeysByPrefix(
          'apc_storage_lock::[a-zA-Z0-9-_]+::',
          array(
            'message' => 'All locks are available and no lock data is stored in the APCu storage.',
            'regexp' => TRUE
          )
        );
      }
    }
  }

  /**
   * Tests that ApcStorageLock::waitForLock() correctly works.
   */
  public function testWait(): void {
    if ($this->skipTest) {
      return;
    }

    if (!$this->assertApcuEmpty()) {
      return;
    }

    if ($this->assertTrue($this->initLocks(), 'All the locks have been created.')) {
      $max_timeout = $this->acquireLocks(2.0, 4.0) + 1.0;

      $lock = ApcStorageLock::get($this->lockNames[0]);
      $message = format_string(
        'The lock is available after waiting for @timeout seconds.',
        array('@timeout' => (int) round($max_timeout))
      );

      // If the lock is available, ApcStorageLock::wait() returns FALSE.
      $this->assertFalse($lock->wait($max_timeout), $message);
    }
  }

}
