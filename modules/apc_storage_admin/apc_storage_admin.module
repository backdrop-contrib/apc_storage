<?php

/**
 * @file
 * Hooks implementations for the APC Storage Admin Pages module.
 */

declare(strict_types=1);

/**
 * Implements hook_permission().
 *
 * @hook
 */
function apc_storage_admin_permission(): array {
  $permissions['access APC Storage reports'] = array(
    'title' => t('Access APC Storage reports'),
    'description' => t('Allows the access to APC Storage reports.')
  );

  return $permissions;
}

/**
 * Implements hook_form_FORM_ID_alter() for system_performance_settings().
 *
 * @hook
 */
function apc_storage_admin_form_system_performance_settings_alter(&$form, &$form_state): void {
  if (extension_loaded('apcu') && apcu_enabled()) {
    $form['clear_cache']['apc_storage_admin_apcu_cache'] = array(
      '#type' => 'submit',
      '#value' => t('Clear APCu cache'),
      '#submit' => array('apc_storage_admin_clear_apcu_cache')
    );
  }
}

/**
 * Submission form handler for system_performance_settings().
 *
 * @form
 */
function apc_storage_admin_clear_apcu_cache(): void {
  if (extension_loaded('apcu') && apcu_enabled()) {
    $regex = '/^(apc_storage_cache|apc_storage_chained_cache)::/';
    if (apcu_delete(new APCUIterator($regex))) {
      backdrop_set_message(t('The APCu cache has been cleared.'));
    }
    else {
      backdrop_set_message(t('The APCu cache could not be cleared.'), 'error');
    }
  }
  else {
    backdrop_set_message(t('The APCu extension is not available.'), 'warning');
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * @hook
 */
function apc_storage_admin_preprocess_page(&$variables): void {
  if (!user_access('access APC Storage reports')) {
    // Do nothing for accounts without access to the reports.
    return;
  }

  if (!backdrop_is_html()) {
    // Do nothing for AJAX requests.
    return;
  }

  try {
    $variables['page_bottom'] .= apc_storage_admin_reports();
  }
  catch (Exception) {
    // Ignore the thrown exception.
  }
}

/**
 * Renders the APC Storage reports.
 *
 * @return string
 *   The APC Storage reports.
 *
 * @throws \Exception The theme hooks are not available.
 */
function apc_storage_admin_reports(): string {
  $item_list = '';

  if (extension_loaded('apcu') && apcu_enabled()) {
    if (!($info = apcu_cache_info())) {
      return '';
    }

    if (!empty($info['num_entries'])) {
      $list = [];
      $list[] = t('Number of entries: @count', array('@count' => $info['num_entries']));
      $list[] = t('Number of hits: @count', array('@count' => $info['num_hits']));
      $list[] = t('Number of misses: @count', array('@count' => $info['num_misses']));
      $list[] = t('Cache items: @count',
        array('@count' => (new APCUIterator('/^apc_storage_cache::/'))->getTotalCount())
      );
      $list[] = t('Chained cache items: @count',
        array('@count' => (new APCUIterator('/^apc_storage_chained_cache::/'))->getTotalCount())
      );
      $list[] = t('Lock items: @count',
        array('@count' => (new APCUIterator('/^apc_storage_lock::/'))->getTotalCount())
      );
      $list[] = t('Queue items: @count',
        array('@count' => (new APCUIterator('/^apc_storage_queue::/'))->getTotalCount())
      );
      $list[] = t('Used memory: @memory', array('@memory' => format_size($info['mem_size'])));

      $item_list = theme('item_list', array('items' => $list));
    }
  }

  if (!$item_list) {
    return '';
  }

  return theme(
    'details',
    array(
      '#open' => TRUE,
      '#summary' => t('APC Storage'),
      '#attributes' => array(
        'class' => array('apc-storage-admin-reports'),
      ),
      '#details' => $item_list
    )
  );
}
