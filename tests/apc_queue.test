<?php

/**
 * @file
 * Contains ApcQueueTestCase.
 */

declare(strict_types=1);

use apc_storage\queue\Queue;

require_once __DIR__ . '/apc_test_base.class.inc';

/**
 * Tests for the queue implementation.
 *
 * @testClass
 */
class ApcQueueTestCase extends ApcTestBase {

  /**
   * The queues used from tests.
   *
   * @var array
   */
  protected array $queues = [];

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    // Clear any existing queue.
    foreach ($this->queues as $data) {
      if (is_object($data->instance) && method_exists($data->instance, 'deleteQueue')) {
        $data->instance->deleteQueue();
      }
    }

    parent::tearDown();
  }

  /**
   * Initializes the queues used to test the APCu queue implementation.
   *
   * @return bool
   *   TRUE if the queues are successfully initialized, FALSE otherwise.
   */
  protected function initQueues(): bool {
    // Clear any existing queue.
    foreach ($this->queues as $data) {
      if (is_object($data->instance) && method_exists($data->instance, 'deleteQueue')) {
        $data->instance->deleteQueue();
      }
    }

    $this->queues = [];

    $queue_names = [
      'test_queue_1_' . $this->randomName(),
      'test_queue_2_' . $this->randomName(),
      'test_queue_3_' . $this->randomName(),
    ];

    foreach ($queue_names as $name) {
      $count = 7 + mt_rand(-2, 4);
      $items = [];
      $queue = new Queue($name);

      for ($i = 0; $i < $count; $i++) {
        $items[] = "item_$i" . $this->randomString(10);
      }

      foreach ($items as $item) {
        $queue->createItem($item);
      }

      $this->queues[$name] = (object) [
        'instance' => $queue,
        'items' => $items,
        'claimedObjects' => [],
      ];
    }

    return TRUE;
  }

  /**
   * Tests that items can be claimed from the queue.
   *
   * This test uses a lease time lower than the default one.
   */
  public function testClaimItem(): void {
    $messages = [
      'An item was claimed from the @queue queue.',
      'All items have been claimed from the @queue queue (@count).',
      'It was not possible to claim further items from the @queue queue after the last one.',
    ];

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $claimed = 0;
        $count = count($data->items);
        $lease_time = 5;

        for ($i = 0; $i < $count; $i++) {
          $obj = $data->instance->claimItem($lease_time);
          $message = format_string($messages[0], ['@queue' => $name]);
          if ($this->assertTrue($obj instanceof stdClass, $message)) {
            $claimed++;
          }
        }

        $this->assertTrue($claimed == $count, format_string($messages[1], ['@queue' => $name, '@count' => $count]));
        $this->assertNull($data->instance->claimItem(), format_string($messages[2], ['@queue' => $name]));
      }
    }
  }

  /**
   * Tests that items can be immediately claimed after they are released.
   */
  public function testReleaseItem(): void {
    $messages = [
      'An item was claimed from the @queue queue.',
      'All items have been claimed from the @queue queue (@count).',
      'It was not possible to claim further items from the @queue queue after the last one.',
      'An item was claimed from the @queue queue for the second time.',
      '@count items have been claimed from the @queue queue for the second time.',
    ];

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $count = count($data->items);
        $data->claimedObjects = [];

        for ($i = 0; $i < $count; $i++) {
          $message = format_string($messages[0], ['@queue' => $name]);
          $obj = $data->instance->claimItem();

          if ($this->assertNotNull($obj, $messages[0])) {
            $data->claimedObjects[] = $obj;
          }
        }

        $this->assertTrue(
          count($data->claimedObjects) == $count,
          format_string($messages[1], ['@queue' => $name, '@count' => $count])
        );
        $this->assertNull($data->instance->claimItem(), format_string($messages[2], ['@queue' => $name]));
      }

      // Release the claimed items and check if they can be claimed again.
      foreach ($this->queues as $name => $data) {
        $count = count($data->claimedObjects);

        foreach ($data->claimedObjects as $obj) {
          $data->instance->releaseItem($obj);
        }

        for ($i = 0; $i < $count; $i++) {
          $obj = $data->instance->claimItem();
          $this->assertNotNull($obj, format_string($messages[3], ['@queue' => $name]));
        }

        $this->assertTrue(
          count($data->claimedObjects) == $count,
          format_string($messages[4], ['@queue' => $name, '@count' => $count])
        );
        $this->assertNull($data->instance->claimItem(), format_string($messages[2], ['@queue' => $name]));
      }
    }
  }

  /**
   * Tests that items cannot be claimed after the queue is deleted.
   */
  public function testDeleteQueue(): void {
    $messages = [
      'Claiming an item from the @queue queue after the queue was deleted failed.',
      'No item was claimed from the @queue queue after the queue was deleted.',
    ];

    if ($this->initQueues()) {
      foreach ($this->queues as $name => $data) {
        $claimed_items = 0;
        $count = count($data->items);

        $data->instance->deleteQueue();

        // Try to claim more items than the queue had; the last try should fail
        // too.
        for ($i = 0; $i < $count + 1; $i++) {
          $message = format_string($messages[0], ['@queue' => $name]);
          $obj = $data->instance->claimItem();

          if (!$this->assertNull($obj, $message)) {
            $claimed_items++;
          }
        }

        $this->assertTrue($claimed_items == 0, format_string($messages[1], ['@queue' => $name]));
      }
    }
  }

}
