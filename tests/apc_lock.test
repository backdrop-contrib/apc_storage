<?php

/**
 * @file
 * Contains ApcLockTestCase.
 */

declare(strict_types=1);

use apc_storage\lock\Lock;

require_once __DIR__ . '/apc_test_base.class.inc';

/**
 * Tests for the lock implementation.
 *
 * @testClass
 */
class ApcLockTestCase extends ApcTestBase {

  /**
   * The names of the locks used by tests.
   *
   * @var array
   */
  protected array $lockNames = [];

  /**
   * {@inheritdoc}
   */
  protected function tearDown(): void {
    if (extension_loaded('apcu') && apcu_enabled()) {
      Lock::releaseAll();
    }

    parent::tearDown();
  }

  /**
   * Initializes a set of locks with random names.
   *
   * @return bool
   *   TRUE if all the locks have been created, FALSE otherwise.
   */
  protected function initLocks(): bool {
    $this->lockNames = array();
    $count = 0;

    for ($i = 0; $i < 4; $i++) {
      $this->lockNames[] = 'lock_' . $this->randomName();
    }

    foreach ($this->lockNames as $name) {
      Lock::get($name);
      $count++;
    }

    return $count == count($this->lockNames);
  }

  /**
   * Acquires a set of locks with random timeouts between the specified bounds.
   *
   * @param float $timeout
   *   The timeout.
   *
   * @return bool
   *   TRUE if all the locks have been acquired, FALSE otherwise.
   */
  protected function acquireLocks(float $timeout): bool {
    $result = TRUE;

    foreach ($this->lockNames as $name) {
      $lock = Lock::get($name);
      $acquired = $lock->acquire($timeout);
      $result = $result && $acquired;
    }

    return $result;
  }

  /**
   * Tests that locks are acquired and expire after the set timeout.
   */
  public function testAcquireLock(): void {
    $messages = [
      'All the locks have been created.',
      'All the locks have been acquired.',
      'Tests will be halted for @delay seconds.',
      'The @name lock is not available after @delay seconds.',
      'The @name lock is available after further @delay seconds.',
      'All the acquired locks are available after they have been released.',
    ];

    if ($this->assertTrue($this->initLocks(), $messages[0])) {
      $delay = 2;

      if ($this->assertTrue($this->acquireLocks(8.0), $messages[1])) {
        $this->pass(format_string($messages[2], ['@delay' => $delay]));
        sleep($delay);

        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);

          $this->assertFalse(
            $lock->maybeAvailable(),
            format_string($messages[3], ['@name' => $name, '@delay' => $delay])
          );
        }

        $available_count = 0;
        $delay = 7;

        $this->pass(format_string($messages[2], ['@delay' => $delay]));
        sleep($delay);

        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);
          $message = format_string($messages[4], ['@name' => $name, '@delay' => $delay]);

          if ($this->assertTrue($lock->maybeAvailable(), $message)) {
            $available_count++;
          }
        }

        $this->assertTrue(count($this->lockNames) == $available_count, $messages[5]);
      }
    }
  }

  /**
   * Tests that Lock::wait() works correctly.
   */
  public function testWait(): void {
    $messages = [
      'All the locks have been created.',
      'All the locks have been acquired.',
      'The @name lock is available after waiting for @timeout seconds.',
      'All the acquired locks are available after @count seconds.',
    ];
    $timeout = 2.0;

    if ($this->assertTrue($this->initLocks(), $messages[0])) {
      $lock_name = $this->lockNames[0];

      if ($this->assertTrue($this->acquireLocks($timeout), $messages[1])) {
        $lock = Lock::get($lock_name);
        $message = format_string($messages[2], ['@name' => $lock_name, '@timeout' => (int) $timeout + 1]);

        // Lock::wait() returns FALSE when the lock is available.
        $this->assertFalse($lock->wait($timeout + 1.0), $message);
      }
    }
  }

  /**
   * Tests that Lock::release() works correctly.
   *
   * After Lock::release() has been called,
   * Lock::maybeAvailable() will return TRUE.
   */
  public function testRelease(): void {
    $messages = [
      'All the locks have been created.',
      'All the locks have been acquired',
      'The @name lock is not available before it has been released.',
      'None of the locks are available before they have been released.',
      'The @name lock is available after it has been released.',
      'All the acquired locks are available after they have been released.',
    ];

    if ($this->assertTrue($this->initLocks(), $messages[0])) {
      $count = 0;

      if ($this->assertTrue($this->acquireLocks(4.0), $messages[1])) {
        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);
          $message = format_string($messages[2], ['@name' => $name]);

          if ($this->assertFalse($lock->maybeAvailable(), $message)) {
            $count++;
          }
        }

        $this->assertTrue($count == count($this->lockNames), $messages[3]);

        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);
          $lock->release();
        }

        $count = 0;

        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);
          $message = format_string($messages[4], ['@name' => $name]);

          if ($this->assertTrue($lock->maybeAvailable(), $message)) {
            $count++;
          }
        }

        $this->assertTrue($count == count($this->lockNames), $messages[5]);
      }
    }
  }

  /**
   * Tests that Lock::releaseAll() works correctly.
   */
  public function testReleaseAll(): void {
    $count = 0;
    $messages = [
      'All the locks have been created.',
      'All the locks have been acquired.',
      'Lock::releaseAll() has been called.',
      'The @name lock is available after it has been released.',
      'All the acquired locks are available after they have been released.',
    ];

    if ($this->assertTrue($this->initLocks(), $messages[0])) {
      if ($this->assertTrue($this->acquireLocks(4.0), $messages[1])) {
        Lock::releaseAll();
        $this->pass($messages[2]);

        foreach ($this->lockNames as $name) {
          $lock = Lock::get($name);
          $message = format_string($messages[3], ['@name' => $name]);

          if ($this->assertTrue($lock->maybeAvailable(), $message)) {
            $count++;
          }
        }
      }

      $this->assertTrue($count == count($this->lockNames), $messages[4]);
    }
  }

}
